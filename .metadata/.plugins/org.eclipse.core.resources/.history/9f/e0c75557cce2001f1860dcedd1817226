package com.examples;

public class Java_Example040_IndexofString{

	public static void main(String[] args) {
		
		// This example demonstrate if string contain any alphabet.
		String str = "JAVA Welcome";
		if(str.indexOf("C")>=0){
			
			
			System.out.println("Existing string has java keyword: "+ str);			
		}
		else{
			System.out.println("Invalid "+str);
		}
		
	}

}
