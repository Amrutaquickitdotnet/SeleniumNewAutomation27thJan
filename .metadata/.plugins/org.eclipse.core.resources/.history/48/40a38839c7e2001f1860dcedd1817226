package com.examples;

public class Java_Example003_Concate {

	/**
	 * args this example will explain you integer "+" operation Please remember Syso
	 * is Short key For System.out.println
	 */
	public static void main(String[] args) {

		int x = 33000;
		short y = 15;
		int result = (x + y);
		int z = x + y;
		System.out.println(z);
		System.out.println("The addition is :" + result);

	
		System.out.println("Size of Integer" + " " + Integer.SIZE);
		System.out.println("Max_Value of Integer" + " " + Integer.MAX_VALUE);
		System.out.println("Min value of Integer"+Integer.MIN_VALUE);
		System.out.println("*************************");
		
		System.out.println("Size of Float" + Float.SIZE);
		System.out.println("Max_Value of Float" + " " + Float.MAX_VALUE);
		System.out.println("Min value of Float"+Float.MIN_VALUE);
		System.out.println("*************************");
		
		
		System.out.println("Size of Double" + Double.SIZE);
		System.out.println("Max_Value of Double" + " " + Double.MAX_VALUE);
		System.out.println("Min value of Float"+Double.MIN_VALUE);
		System.out.println("*************************");
		
		
		
		System.out.println("Size of Short"+Short.SIZE);
		System.out.println("Size of Byte."+Byte.SIZE);
		
		System.out.println("Size of Long"+Long.SIZE);
		System.out.println("Max_Value of Long"+Long.MAX_VALUE);
		System.out.println("Min_Value of Double"+Long.MIN_VALUE);

		// Float Operation
		
		  System.out.println("Max value of Float"+Float.MAX_VALUE);
		  System.out.println("Min value of Float"+Float.MIN_VALUE);
		  
		  System.out.println(Double.MIN_VALUE);
		  System.out.println(Integer.MAX_VALUE);
		  System.out.println(Double.MAX_VALUE);
		 
	}

}

